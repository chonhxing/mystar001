# 复制成 server/.env 后填自己的值：cp server/.env.example server/.env
# 启动：npm start

# ---------- DeepSeek（必填，key 只能待在服务端）----------
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认 flash（实测一次解读 9~14 秒）；换 deepseek-v4-pro 要 50 秒 / 4 倍价钱，
# 而且更容易被 max_tokens 截断，除非有明确理由否则别换。
DEEPSEEK_MODEL=deepseek-flash
# 单次尝试超时。flash 实测 9~14 秒，45 秒是 3 倍余量。
DEEPSEEK_TIMEOUT_MS=45000
# 整次调用的总预算（含重试）。⚠️ 必须小于 config/index.js 的 DIVINATE_WAIT_MS（65 秒），
# 否则客户端等不及先显示了本地模板文案，服务端还在为一个没人等的请求烧钱。
DEEPSEEK_BUDGET_MS=50000
# 同步接口（POST /api/divinate，老客户端用）的预算：必须小于客户端那次请求的超时
# （config.API_TIMEOUT = 50 秒），否则客户端断线后服务端还在跑。
DEEPSEEK_SYNC_BUDGET_MS=35000
# maxTokens 要同时覆盖"思考 + 五段文案"：推理模型的思考也占 output token，给小了 JSON 会被截断
DEEPSEEK_MAX_TOKENS=4000
# 官方建议创意写作 1.3；我们要求严格 JSON，压到 1.1 更稳
DEEPSEEK_TEMPERATURE=1.1
DEEPSEEK_RETRIES=1
# 1 = 让模型在候选池里自己挑角色（更 AI 原生，但出场分布会变）
AI_PICKS_CHARACTER=0

# ---------- 服务 ----------
PORT=8787
HOST=0.0.0.0
DATA_DIR=./server/runtime

# ---------- 微信（不填 appid/secret 则进开发模式，用设备 id 认人，方便本地调试）----------
WX_APPID=
WX_SECRET=
# ⚠️ 服务端接口（access_token / 查订单 / 内容安全）对调用方有 IP 白名单限制。
#    报 40164 就是 IP 不在白名单：去 MP 后台「开发管理-开发设置-IP 白名单」加上服务器出口 IP。
WX_API_BASE=https://api.weixin.qq.com
# 说明：小游戏**不需要**额外的登录配置 —— wx.login 静默拿 code，服务端换 openid 即完成。
# 想跨应用（公众号/其他小程序）识别同一用户，才需要去微信开放平台绑定并拿 unionid。

# ---------- 消息推送（发货推送）----------
# ⚠️ 这两项不填，MP 后台「虚拟支付2.0 - 基本配置 - 基础配置 - 发货推送配置」里的 URL
#    验证就过不了（微信会发 GET 请求要你原样返回 echostr），配置存不下来，
#    结果就是**用户付了钱但一条发货推送都收不到**。
#    这两项都是你自己在后台填的（不是微信发给你的）：Token 随便起一个复杂串，
#    EncodingAESKey 点"随机生成"。消息加解密方式建议选「安全模式」。
WX_NOTIFY_TOKEN=
WX_ENCODING_AES_KEY=
# 签发会话 token 的密钥，上线必须换成长随机串
AUTH_SECRET=change-me-to-a-long-random-string

# ---------- 成本闸门 ----------
DAILY_PER_USER=10
DAILY_GLOBAL=3000
PER_MINUTE_PER_IP=40
PROSE_CACHE_DAYS=30

# ---------- 虚拟支付 2.0（道具直购）----------
# ⚠️ 开通门槛（官方《虚拟支付进件》）：企业/个体工商户主体 + 已接入中宣部实名认证系统
#    + **游戏版号、软著、自审自查报告及相关授权**。没有版号就开不了，先留空。
# 留空时所有支付接口返回"未开通"，客户端自动隐藏付费入口，只走"看广告解锁"。
# 这些密钥只在服务端使用，**绝不下发客户端**。

# MP 后台「虚拟支付 2.0 - 基础配置」里的 AppKey，用于 paySig 和发货推送校验
MIDAS_APP_KEY=
# 「基础配置 - 支付应用 ID」
MIDAS_OFFER_ID=
# 「基础配置 - 游戏币/道具配置 - 分区配置 - 分区 ID」
MIDAS_ZONE_ID=1
# 0 = 正式环境，1 = 沙箱环境（沙箱只有开发版/体验版可用，正式版必须用 0）
MIDAS_ENV=0

# 支付签名的拼接方式。官方的《支付请求签名算法说明》在腾讯文档里、需要权限才能看，
# 所以"拼接串里放接口英文名还是路径"无法从公开文档确认。默认沿用
# requestMidasPaymentGameItem 文档里的口径（接口英文名）。
# 接入真实支付时如果签名报错（查订单返回 90011 = pay_sig 错误），改这一个值即可：
#   english_name（默认）| path | path_no_slash | body_only
MIDAS_SIG_MODE=english_name

# 道具档位：必须与 MP 后台「道具配置」里的 id 和价格**完全一致**，
# 不一致会在支付时报 -15016（道具价格错误）。价格单位是「分」。
MIDAS_GOODS_1D=pass_1d
MIDAS_PRICE_1D=600
MIDAS_GOODS_7D=pass_7d
MIDAS_PRICE_7D=3000
MIDAS_GOODS_30D=pass_30d
MIDAS_PRICE_30D=10000

# ---------- 合规 ----------
SHOW_AI_LABEL=1
ADMIN_TOKEN=换成一个只有你知道的串

# ---------- 微信云托管（可选；不填就是本地「内存 + JSON 文件」模式）----------
#
# ⚠️ 这三个值填在**云托管控制台 → 服务设置 → 环境变量**里，
#    不要写进 server/.env 提交上去（.env 在 .gitignore 里，但还是再说一遍）。
#    DB_HOST 用云托管 MySQL 的**内网地址**（控制台 → 数据库 → 连接信息）。
#
# 填了 DB_HOST 之后，服务端会把内存里那份 JSON 快照整份存进 MySQL
# （原因和代价见 server/store-mysql.js：单实例，多副本会互相覆盖）。
# 建表 SQL：cloud/init.sql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wo_tui_zhan_xing
DB_SSL=0

# ⚠️ 云托管要求容器监听控制台里配置的端口（默认 80），平台会把实际端口放进 PORT。
#    本地开发不用设，保持上面那个 8787。
# PORT=80
