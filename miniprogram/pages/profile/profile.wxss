.pf-user { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 8rpx 0; }

.pf-avatar {
  flex: none;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #E8C87A;
  background: linear-gradient(150deg, rgba(139, 108, 240, 0.34), rgba(232, 200, 122, 0.14));
  border: 1rpx solid rgba(232, 200, 122, 0.35);
}

.pf-info { flex: 1; min-width: 0; }
.pf-name { display: block; font-size: 38rpx; font-weight: 600; color: #E9E7F7; }
.pf-line { display: block; margin-top: 6rpx; font-size: 23rpx; color: #A9A4C7; }
.pf-chart { display: block; margin-top: 6rpx; font-size: 22rpx; color: #8E88B0; }

/* 统计 */
.pf-stats { display: flex; gap: 20rpx; }
.pf-stat {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.pf-stat-num { display: block; font-size: 40rpx; font-weight: 700; color: #E8C87A; }
.pf-stat-k { display: block; margin-top: 6rpx; font-size: 21rpx; color: #6E6A8F; }

/* 历史 */
.pf-his {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
}

.pf-his + .pf-his { border-top: 1rpx solid rgba(255, 255, 255, 0.06); }
.pf-his-main { flex: 1; min-width: 0; }
.pf-his-name { font-size: 29rpx; color: #E9E7F7; }
.pf-his-work { display: block; margin-top: 6rpx; font-size: 21rpx; color: #6E6A8F; }
.pf-his-right { flex: none; text-align: right; }
.pf-his-score { display: block; font-size: 28rpx; font-weight: 600; color: #E8C87A; }
.pf-his-time { display: block; margin-top: 4rpx; font-size: 20rpx; color: #575374; }

/* 设置行 */
.pf-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
}

.pf-setting + .pf-setting { border-top: 1rpx solid rgba(255, 255, 255, 0.06); }
.pf-setting-text { flex: 1; min-width: 0; }
.pf-setting-t { display: block; font-size: 28rpx; color: #E9E7F7; }
.pf-setting-d { display: block; margin-top: 6rpx; font-size: 21rpx; line-height: 1.6; color: #6E6A8F; }

.switch {
  flex: none;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.switch-on { border-color: rgba(232, 200, 122, 0.4); background: rgba(232, 200, 122, 0.12); }
.switch-label { font-size: 24rpx; color: #6E6A8F; }
.switch-label-on { color: #E8C87A; }

.pf-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #575374; }
.pf-dot-ok { background: #7BD88F; }
.pf-dot-warn { background: #E8C87A; }
.pf-dot-bad { background: #E86A6A; }
.pf-dot-off { background: #575374; }

/* 头像：用原生 button 承载 chooseAvatar，所以要把 button 的默认样式全部抹掉 */
.pf-avatar-btn {
  flex: none;
  width: 130rpx;
  height: 130rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: hidden;
}

.pf-avatar-btn::after {
  border: none;
}

.pf-avatar-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(232, 200, 122, 0.45);
  display: block;
}

/* 昵称输入：默认样式同样要抹掉，否则会有输入框的边框和背景 */
.pf-nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #E9E7F7;
  padding: 0;
  margin: 0 0 6rpx;
  min-height: 44rpx;
}

.pf-nickname-ph {
  color: #575374;
}
