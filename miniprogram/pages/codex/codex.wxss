.cx-head { padding: 20rpx 8rpx 8rpx; }

.cx-count { display: flex; align-items: baseline; }
.cx-count-num { font-size: 56rpx; font-weight: 700; color: #E8C87A; }
.cx-count-total { font-size: 24rpx; color: #6E6A8F; margin-left: 6rpx; }

.cx-bar {
  margin-top: 24rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.cx-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #8B6CF0, #E8C87A);
  transition: width 0.5s ease;
}

/* 筛选 */
.cx-filters { margin-top: 28rpx; }
.cx-chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cx-chip-row + .cx-chip-row { margin-top: 12rpx; }

.cx-chip {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #A9A4C7;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.cx-chip-on {
  color: #2A1E05;
  font-weight: 600;
  background: linear-gradient(135deg, #FFE9AE, #E8C87A);
  border-color: transparent;
}

/* 网格 */
.cx-grid {
  margin-top: 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.cx-cell { width: calc(50% - 10rpx); }

.cx-count-text {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6E6A8F;
  text-align: center;
}

.cx-empty { padding: 120rpx 0; text-align: center; }

.actions { margin-top: 48rpx; }
