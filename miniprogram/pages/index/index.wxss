.hero { padding: 24rpx 8rpx 8rpx; }

.hero-arc {
  font-size: 24rpx;
  letter-spacing: 14rpx;
  color: rgba(232, 200, 122, 0.55);
  margin-bottom: 12rpx;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2, #A9A4C7);
}

.hero-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-3, #6E6A8F);
}

/* ---------- 今日运势 ---------- */
.today-level { text-align: right; }
.today-stars { display: block; font-size: 22rpx; color: #E8C87A; letter-spacing: 2rpx; }
.today-name { display: block; font-size: 30rpx; font-weight: 700; color: #E8C87A; }

.today-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #CFCBE8;
  line-height: 1.7;
}

.today-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 2rpx 0;
}

.today-cell {
  width: 50%;
  padding: 12rpx 12rpx 12rpx 0;
  box-sizing: border-box;
}

.today-k {
  display: block;
  font-size: 20rpx;
  color: #6E6A8F;
  margin-bottom: 4rpx;
}

.today-v {
  font-size: 24rpx;
  color: #E9E7F7;
  line-height: 1.5;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.today-tip {
  margin-top: 8rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  font-size: 22rpx;
  color: #8E88B0;
}

/* ---------- 表单 ---------- */
.field + .field { margin-top: 28rpx; }

.field-label {
  display: block;
  font-size: 24rpx;
  color: #A9A4C7;
  margin-bottom: 10rpx;
}

.field-input {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #E9E7F7;
  font-size: 28rpx;
}

.ph { color: #575374; }

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #E9E7F7;
  font-size: 28rpx;
}

.field-arrow { color: #6E6A8F; font-size: 36rpx; line-height: 1; }

.field-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6E6A8F;
}

/* 分段控件 */
.seg {
  display: flex;
  gap: 12rpx;
}

.seg-item {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #A9A4C7;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.seg-on {
  color: #2A1E05;
  font-weight: 600;
  background: linear-gradient(135deg, #FFE9AE, #E8C87A);
  border-color: transparent;
}

/* 开关 */
.switch {
  min-width: 108rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.switch-label { font-size: 24rpx; color: #6E6A8F; }
.switch-label-on { color: #E8C87A; }

.ai-row { align-items: flex-start; }

/* ---------- 行动 ---------- */
.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress-line {
  margin-top: 32rpx;
  text-align: center;
}
