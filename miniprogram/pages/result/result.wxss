/* ============ 占卜仪式 ============ */
.casting {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(700rpx 700rpx at 50% 42%, #191337 0%, #0B0A1F 68%);
}

.casting-ring {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: castSpin 6s linear infinite;
}

.casting-ring::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 1rpx solid rgba(232, 200, 122, 0.55);
}

.casting-ring::after {
  content: '';
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(139, 108, 240, 0.5);
  animation: castSpin 9s linear infinite reverse;
}

.casting-ring-inner {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, rgba(232, 200, 122, 0.9), rgba(139, 108, 240, 0.7), rgba(99, 215, 232, 0.6), rgba(232, 200, 122, 0.9));
  filter: blur(2rpx);
  animation: castPulse 1.8s ease-in-out infinite;
}

.casting-glow {
  position: absolute;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 200, 122, 0.22), transparent 62%);
  animation: castPulse 2.6s ease-in-out infinite;
}

@keyframes castSpin { to { transform: rotate(360deg); } }
@keyframes castPulse {
  0%, 100% { transform: scale(0.94); opacity: 0.75; }
  50%      { transform: scale(1.06); opacity: 1; }
}

.casting-text {
  margin-top: 60rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  color: #E8C87A;
}

.casting-sub {
  margin-top: 14rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #6E6A8F;
}

/* ============ 空状态 ============ */
.empty {
  padding-top: 30vh;
  text-align: center;
}

.empty-glyph { font-size: 90rpx; color: rgba(232, 200, 122, 0.5); }
.empty-text { display: block; margin-top: 24rpx; font-size: 28rpx; color: #A9A4C7; }

/* ============ 结果头 ============ */
.rs-head { padding: 20rpx 8rpx 8rpx; }

.rs-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  background: linear-gradient(180deg, #FFF6DC, #E8C87A 60%, #A87A22);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.rs-sub { margin-top: 12rpx; font-size: 24rpx; color: #A9A4C7; }

.rs-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }

/* ============ 共享命途 ============ */
.rs-shared { margin-top: 20rpx; }
.rs-shared-label { display: block; font-size: 22rpx; color: #6E6A8F; margin-bottom: 10rpx; }
.rs-shared-list { display: flex; flex-wrap: wrap; gap: 12rpx; }

/* ============ 正文段落 ============ */
.para {
  display: block;
  font-size: 28rpx;
  line-height: 1.95;
  color: #DEDAF2;
  letter-spacing: 0.5rpx;
}

.fate-list { display: flex; flex-direction: column; gap: 20rpx; }
.fate-head { display: flex; align-items: baseline; justify-content: space-between; }
.fate-name { font-size: 28rpx; font-weight: 600; color: #E8C87A; }
.fate-summary { display: block; margin-top: 4rpx; font-size: 24rpx; line-height: 1.7; color: #A9A4C7; }

/* ============ 键值行 ============ */
.kv {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
}

.kv + .kv { border-top: 1rpx solid rgba(255, 255, 255, 0.06); }
.kv-k { flex: none; width: 120rpx; font-size: 24rpx; color: #6E6A8F; }
.kv-right { flex: 1; text-align: right; }
.kv-v { font-size: 28rpx; color: #E9E7F7; }
.kv-note { display: block; margin-top: 4rpx; font-size: 22rpx; color: #7A7597; }

/* ============ 副推 ============ */
.side-list { display: flex; flex-direction: column; gap: 16rpx; }

/* ============ 对立轴 ============ */
.anti-axis {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(139, 108, 240, 0.1);
  border: 1rpx solid rgba(139, 108, 240, 0.22);
}

.anti-axis-text { font-size: 23rpx; line-height: 1.7; color: #C6B4FF; }

/* ============ 神谕 ============ */
.oracle {
  margin-top: 32rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(232, 200, 122, 0.12), rgba(232, 200, 122, 0.02)),
    rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(232, 200, 122, 0.28);
}

.oracle-label {
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: #E8C87A;
  margin-bottom: 14rpx;
}

.oracle-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #F3EEDC;
  letter-spacing: 1rpx;
}

/* ============ 运势 ============ */
.fortune-row { display: flex; gap: 16rpx; padding: 8rpx 0; }
.fortune-k { flex: none; width: 60rpx; font-size: 24rpx; color: #E8C87A; }
.fortune-v { flex: 1; font-size: 25rpx; line-height: 1.6; color: #CFCBE8; }

/* ============ 提示 ============ */
.notice {
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #A9A4C7;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.notice-good {
  color: #C6B4FF;
  background: rgba(139, 108, 240, 0.12);
  border-color: rgba(139, 108, 240, 0.26);
}

/* ============ 操作 ============ */
.actions { margin-top: 44rpx; }

.rs-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.rs-half { flex: 1; }

/* 覆盖小程序 button 的默认样式 */
button.btn {
  padding: 0;
  margin: 0;
  line-height: 96rpx;
  background-clip: padding-box;
}

button.btn::after { border: none; }

/* ============ 合规 ============ */
.ai-label {
  margin-top: 32rpx;
  text-align: center;
  font-size: 21rpx;
  color: #6E6A8F;
}
