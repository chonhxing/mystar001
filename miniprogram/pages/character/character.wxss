.ch-head { padding: 20rpx 0 8rpx; }

.ch-locked {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6E6A8F;
}

.ch-motif {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #E9E7F7;
}

.ch-signature {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #A9A4C7;
}

.ch-shared { margin-top: 24rpx; }

.ch-fate + .ch-fate {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.ch-fate-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #E8C87A;
}

.ch-fate-line {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #CFCBE8;
}

.ch-fate-shadow {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7A7597;
}

.ch-dominant {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ch-dominant-k { font-size: 22rpx; color: #6E6A8F; }
.ch-dominant-v { font-size: 28rpx; color: #E8C87A; }

.ch-axis-note {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 21rpx;
  line-height: 1.7;
  color: #6E6A8F;
}

.actions {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

button.btn { padding: 0; margin: 0; line-height: 96rpx; background-clip: padding-box; }
button.btn::after { border: none; }
