.sb {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: linear-gradient(180deg, #0B0A1F 0%, #100D26 45%, #08071A 100%);
}

/* ---- 星云 ---- */
.sb-nebula {
  position: absolute;
  left: -20%;
  top: -10%;
  width: 140%;
  height: 90%;
  background:
    radial-gradient(900rpx 700rpx at 15% 8%, rgba(139, 108, 240, 0.30), transparent 70%),
    radial-gradient(800rpx 600rpx at 88% 22%, rgba(99, 215, 232, 0.16), transparent 72%),
    radial-gradient(1000rpx 800rpx at 50% 100%, rgba(232, 200, 122, 0.14), transparent 70%);
  animation: sbDrift 26s ease-in-out infinite alternate;
}

.sb-legend .sb-nebula {
  background:
    radial-gradient(900rpx 700rpx at 20% 10%, rgba(232, 200, 122, 0.30), transparent 70%),
    radial-gradient(800rpx 600rpx at 85% 25%, rgba(139, 108, 240, 0.24), transparent 72%),
    radial-gradient(1000rpx 800rpx at 50% 100%, rgba(232, 200, 122, 0.16), transparent 70%);
}

@keyframes sbDrift {
  from { transform: translate3d(0, 0, 0) scale(1); }
  to   { transform: translate3d(-2%, 2%, 0) scale(1.06); }
}

/* ---- 星点 ---- */
.sb-stars {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
  background-image:
    radial-gradient(2rpx 2rpx at 12% 14%, #fff, transparent),
    radial-gradient(2rpx 2rpx at 32% 6%, rgba(255,255,255,0.8), transparent),
    radial-gradient(3rpx 3rpx at 68% 12%, #fff, transparent),
    radial-gradient(2rpx 2rpx at 84% 28%, rgba(255,255,255,0.7), transparent),
    radial-gradient(2rpx 2rpx at 22% 46%, rgba(255,255,255,0.6), transparent),
    radial-gradient(3rpx 3rpx at 76% 58%, #fff, transparent),
    radial-gradient(2rpx 2rpx at 46% 72%, rgba(255,255,255,0.75), transparent),
    radial-gradient(2rpx 2rpx at 92% 84%, rgba(255,255,255,0.6), transparent),
    radial-gradient(2rpx 2rpx at 8% 88%, rgba(255,255,255,0.5), transparent),
    radial-gradient(2rpx 2rpx at 58% 36%, rgba(255,255,255,0.5), transparent),
    radial-gradient(2rpx 2rpx at 40% 92%, rgba(255,255,255,0.4), transparent);
  animation: sbTwinkle 5.5s ease-in-out infinite alternate;
}

@keyframes sbTwinkle {
  from { opacity: 0.3; }
  to   { opacity: 0.78; }
}

/* ---- 十二宫刻度环 ---- */
.sb-ring {
  position: absolute;
  left: 50%;
  top: -140rpx;
  width: 880rpx;
  height: 880rpx;
  margin-left: -440rpx;
  opacity: 0.24;
  animation: sbSpin 140s linear infinite;
}

.sb-ring::before {
  content: '';
  position: absolute;
  left: 60rpx;
  top: 60rpx;
  right: 60rpx;
  bottom: 60rpx;
  border: 1rpx solid rgba(232, 200, 122, 0.5);
  border-radius: 50%;
}

.sb-ring::after {
  content: '';
  position: absolute;
  left: 160rpx;
  top: 160rpx;
  right: 160rpx;
  bottom: 160rpx;
  border: 1rpx dashed rgba(139, 108, 240, 0.5);
  border-radius: 50%;
}

.sb-tick {
  position: absolute;
  left: 50%;
  top: 40rpx;
  width: 2rpx;
  height: 40rpx;
  margin-left: -1rpx;
  background: rgba(232, 200, 122, 0.7);
  transform-origin: 50% 400rpx;
}

@keyframes sbSpin {
  to { transform: rotate(360deg); }
}
