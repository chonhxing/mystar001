.db-row + .db-row { margin-top: 22rpx; }

.db-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.db-name { font-size: 24rpx; color: #A9A4C7; }

.db-badge {
  font-size: 20rpx;
  padding: 1rpx 10rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
}

.db-badge-pos { color: #E8C87A; }
.db-badge-neg { color: #C6B4FF; }

.db-value {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.db-track {
  position: relative;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.db-fill {
  height: 100%;
  border-radius: 6rpx;
  box-shadow: 0 0 12rpx rgba(232, 200, 122, 0.35);
  transition: width 0.5s cubic-bezier(0.22, 0.85, 0.3, 1);
}

/* 中位线：让"偏哪一极"一眼可见 */
.db-center {
  position: absolute;
  left: 50%;
  top: 0;
  width: 1rpx;
  height: 100%;
  background: rgba(255, 255, 255, 0.25);
}

.db-poles {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #575374;
}

.db-pole-on { color: #9A94BC; }
.db-pole-r { text-align: right; }
